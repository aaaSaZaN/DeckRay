{
  "log": {
    "loglevel": "warning"
  },
  "dns": {
    "servers": [
      "1.1.1.1",
      "8.8.8.8",
      "localhost"
    ]
  },
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "inboundTag": ["tun", "socks", "http"],
        "port": 53,
        "outboundTag": "dns-out"
      },
      {
        "type": "field",
        "ip": ["geoip:private"],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "inboundTag": ["tun"],
        "outboundTag": "proxy"
      },
      {
        "type": "field",
        "inboundTag": ["socks", "http"],
        "outboundTag": "proxy"
      }
    ]
  },
  "inbounds": "__INBOUNDS__",
  "outbounds": [
    {
      "protocol": "dns",
      "tag": "dns-out"
    },
    "__OUTBOUNDS__"
  ]
}
